<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AlturaNova.Application\AlturaNova.Application.csproj" />
    <ProjectReference Include="..\AlturaNova.Infrastructure\AlturaNova.Infrastructure.csproj" />
    <ProjectReference Include="..\AlturaNova.Domain\AlturaNova.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      NU1903: Microsoft.OpenApi 2.0.0 is pulled transitively by Microsoft.AspNetCore.OpenApi 10.0.10.
      The advisory has no framework-compatible fix yet (3.x breaks the .NET 10 XML-comment source
      generator). Suppressed pending an upstream bump of Microsoft.AspNetCore.OpenApi.
    -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

</Project>
